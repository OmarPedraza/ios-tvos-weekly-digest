# ── Email ────────────────────────────────────────────────────────────────────
# SMTP credentials used to send the digest email (e.g. a Gmail app password).
EMAIL_USER=you@example.com
EMAIL_PASS=your-smtp-password
TARGET_EMAIL=recipient@example.com

# ── Notion (optional) ────────────────────────────────────────────────────────
# When both variables are set, digest items are saved to a weekly Notion database.
NOTION_API_KEY=secret_...
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Hugging Face (optional) ──────────────────────────────────────────────────
# Enables AI summarization via the Hugging Face Inference API.
HF_API_KEY=hf_...

# ── Dry run (optional) ───────────────────────────────────────────────────────
# Set to true to skip Notion writes and email sending (fetching/enrichment still runs).
# DRY_RUN=true
